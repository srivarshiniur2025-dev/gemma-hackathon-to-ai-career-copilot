# Root .env — Backend secrets (copy to .env and fill in; never commit .env)
#
# Vercel (full-stack deploy via vercel.json Services):
#   Set these on the **backend** service in Project Settings → Environment Variables:
#   GOOGLE_API_KEY, MONGODB_URI, MONGODB_DB, FIREBASE_PROJECT_ID, CORS_ORIGINS
#   The frontend service receives BACKEND_URL automatically via service binding.
#   Optional: NEXT_PUBLIC_WS_URL=wss://your-app.vercel.app (defaults to same-origin)
#
GOOGLE_API_KEY=your_google_api_key_here


# Gemma 4 model (primary instruction-tuned model)
GEMMA_MODEL=gemma-4-27b-it
# Comma-separated fallbacks if primary is unavailable
GEMMA_FALLBACK_MODELS=gemma-4-26b-a4b-it,gemma-4-4b-it

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=career_copilot
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Internship search — Gemma 4 + Google Search (uses GOOGLE_API_KEY, no extra keys)
# Optional extras: SERPAPI_KEY, Adzuna — see below
SERPAPI_KEY=your_serpapi_key

# Adzuna job board (optional free tier) — https://developer.adzuna.com
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
ADZUNA_COUNTRY=us
